# The backend runs on EC2. Point this at its origin, no trailing slash.
#   EXPO_PUBLIC_API_URL=http://ec2-1-2-3-4.compute-1.amazonaws.com:8000
#
# Leave unset to run the app on fixtures with no backend (demo mode).
#
# Plain HTTP needs app.json's android.usesCleartextTraffic and the iOS ATS
# exception. Both are already configured; note cleartext applies to a dev
# build, while Expo Go permits it regardless.
EXPO_PUBLIC_API_URL=
